{
  "version": 2,
  "name": "with-allergy-safecook",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/recipes.json",
      "headers": {
        "cache-control": "s-maxage=3600, stale-while-revalidate"
      },
      "dest": "/recipes.json"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
